// @ts-nocheck
import { router, useFocusEffect } from "expo-router";
import { useCallback, useState } from "react";
import { Pressable, ScrollView, StyleSheet, Text, View } from "react-native";
import { SafeAreaView } from "react-native-safe-area-context";
import { useSQLiteContext } from "expo-sqlite";
import { DEFAULT_TOURNAMENT_ID } from "@/database/sqlite";
import { getTournamentChampion, type TeamRecord } from "@/database/repositories";

type ActiveMatchInfo = {
  id: string;
  homeName: string;
  awayName: string;
  courtNumber: number;
  currentSet: number;
  homePoints: number;
  awayPoints: number;
};

type DashboardData = {
  teamsCount: number;
  scheduledCount: number;
  inProgressCount: number;
  completedCount: number;
  activeMatches: ActiveMatchInfo[];
  hasMatches: boolean;
  pendingSyncCount: number;
  champion: TeamRecord | null;
};

export default function HomeScreen() {
  const db = useSQLiteContext();
  const [data, setData] = useState<DashboardData>({
    teamsCount: 0,
    scheduledCount: 0,
    inProgressCount: 0,
    completedCount: 0,
    activeMatches: [],
    hasMatches: false,
    pendingSyncCount: 0,
    champion: null,
  });

  const [activeTab, setActiveTab] = useState<"hub" | "rules">("hub");

  const loadData = useCallback(async () => {
    try {
      const teamsRow = await db.getFirstAsync<{ count: number }>("SELECT COUNT(*) AS count FROM teams");
      const schedRow = await db.getFirstAsync<{ count: number }>("SELECT COUNT(*) AS count FROM matches WHERE status = 'scheduled'");
      const inProgRow = await db.getFirstAsync<{ count: number }>("SELECT COUNT(*) AS count FROM matches WHERE status = 'in_progress'");
      const compRow = await db.getFirstAsync<{ count: number }>("SELECT COUNT(*) AS count FROM matches WHERE status IN ('completed', 'walkover')");
      const firstMatch = await db.getFirstAsync<{ id: string }>("SELECT id FROM matches LIMIT 1");
      const syncRow = await db.getFirstAsync<{ count: number }>("SELECT COUNT(*) AS count FROM sync_queue WHERE status = 'pending'");
      const champ = await getTournamentChampion(db, DEFAULT_TOURNAMENT_ID);

      // Obtener detalles de TODOS los partidos en curso (Cancha 1 y Cancha 2 simultáneos)
      const activeMatchRows = await db.getAllAsync<{
        id: string;
        home_name: string;
        away_name: string;
        court_number: number;
        current_set: number;
      }>(
        `SELECT m.id, home.name AS home_name, away.name AS away_name,
                COALESCE(m.court_number, 1) AS court_number, m.current_set
         FROM matches m
         JOIN teams home ON home.id = m.home_team_id
         JOIN teams away ON away.id = m.away_team_id
         WHERE m.status = 'in_progress'
         ORDER BY court_number ASC`
      );

      const activeMatchesList: ActiveMatchInfo[] = [];
      for (const row of activeMatchRows) {
        const setScore = await db.getFirstAsync<{ home_points: number; away_points: number }>(
          "SELECT home_points, away_points FROM match_sets WHERE match_id = ? AND set_number = ?",
          row.id,
          row.current_set
        );
        activeMatchesList.push({
          id: row.id,
          homeName: row.home_name,
          awayName: row.away_name,
          courtNumber: row.court_number,
          currentSet: row.current_set,
          homePoints: setScore?.home_points ?? 0,
          awayPoints: setScore?.away_points ?? 0,
        });
      }

      setData({
        teamsCount: teamsRow?.count ?? 0,
        scheduledCount: schedRow?.count ?? 0,
        inProgressCount: inProgRow?.count ?? 0,
        completedCount: compRow?.count ?? 0,
        activeMatches: activeMatchesList,
        hasMatches: Boolean(firstMatch),
        pendingSyncCount: syncRow?.count ?? 0,
        champion: champ,
      });
    } catch {
      // Si la base no está lista todavía
    }
  }, [db]);

  useFocusEffect(
    useCallback(() => {
      void loadData();
    }, [loadData])
  );

  return (
    <SafeAreaView style={styles.safe}>
      <ScrollView contentContainerStyle={styles.container}>
        {/* Cabecera Deportiva */}
        <View style={styles.header}>
          <View style={styles.brandRow}>
            <View style={styles.logoBadge}>
              <Text style={styles.logoIcon}>🏐</Text>
            </View>
            <View style={styles.brandCopy}>
              <Text style={styles.brandClub}>GAMMA VOLEY CLUB · GAM LOGÍSTICA</Text>
              <Text style={styles.brandTitle}>Torneo Mixto 2026</Text>
            </View>
          </View>
          <View style={styles.tournamentMeta}>
            <Text style={styles.metaBadge}>📅 14 y 15 Nov 2026</Text>
            <Text style={styles.metaBadge}>🏟️ 2 Canchas</Text>
            <Text style={styles.metaBadge}>👥 Máx 8 Equipos</Text>
          </View>
        </View>

        {/* Banner de Proclamación del Campeón */}
        {data.champion && (
          <Pressable
            onPress={() => router.push("./standings")}
            style={({ pressed }) => [styles.championBanner, pressed && styles.pressed]}
          >
