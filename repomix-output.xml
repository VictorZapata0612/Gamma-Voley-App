                <View style={[styles.menuIconContainer, styles.iconGroups]}>
                  <Text style={styles.menuCardIcon}>📋</Text>
                </View>
                <View style={styles.menuCardCopy}>
                  <Text style={styles.menuCardTitle}>Grupos y Calendario</Text>
