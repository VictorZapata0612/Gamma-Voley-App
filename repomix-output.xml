                <View style={[styles.menuIconContainer, styles.iconStandings]}>
                  <Text style={styles.menuCardIcon}>🏆</Text>
                </View>
                <View style={styles.menuCardCopy}>
                  <Text style={styles.menuCardTitle}>Tabla y Cuadro de Semifinales</Text>
