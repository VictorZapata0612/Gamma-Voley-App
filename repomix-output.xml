            </Text>
          </Pressable>
          <Pressable
            onPress={() => setActiveTab("rules")}
            style={[styles.navTab, activeTab === "rules" && styles.navTabActive]}
          >
            <Text style={[styles.navTabText, activeTab === "rules" && styles.navTabTextActive]}>
              Guía Didáctica y Reglas
            </Text>
          </Pressable>
        </View>

        {activeTab === "hub" ? (
          <>
            {/* Tarjetas de Partidos en Vivo Simultáneos (Cancha 1 y Cancha 2) */}
            {data.activeMatches.length > 0 ? (
              <View style={styles.liveSection}>
                <Text style={styles.liveSectionHeaderTitle}>🔴 PARTIDOS EN JUEGO EN VIVO ({data.activeMatches.length})</Text>
                {data.activeMatches.map((activeMatch) => (
                  <Pressable
                    key={activeMatch.id}
                    onPress={() => router.push(`/live-score?matchId=${encodeURIComponent(activeMatch.id)}`)}
                    style={({ pressed }) => [styles.liveHeroCard, pressed && styles.pressed]}
                  >
                    <View style={styles.liveHeroTop}>
                      <View style={styles.livePulse}>
                        <View style={styles.liveDot} />
                        <Text style={styles.liveHeroLabel}>
                          EN VIVO · CANCHA {activeMatch.courtNumber}
                        </Text>
                      </View>
                      <Text style={styles.setTag}>SET {activeMatch.currentSet}</Text>
                    </View>

                    <View style={styles.liveScoreRow}>
                      <View style={styles.liveTeamCol}>
                        <Text style={styles.liveTeamName} numberOfLines={1}>{activeMatch.homeName}</Text>
                        <Text style={styles.livePoints}>{activeMatch.homePoints}</Text>
                      </View>
                      <Text style={styles.liveVs}>VS</Text>
                      <View style={styles.liveTeamCol}>
                        <Text style={styles.liveTeamName} numberOfLines={1}>{activeMatch.awayName}</Text>
                        <Text style={styles.livePoints}>{activeMatch.awayPoints}</Text>
                      </View>
                    </View>

                    <View style={styles.liveActionHint}>
                      <Text style={styles.liveActionText}>Toca para abrir la mesa de control de Cancha {activeMatch.courtNumber} ⚡</Text>
                    </View>
                  </Pressable>
                ))}
              </View>
            ) : null}

            {/* Estado de las 2 Canchas del Torneo */}
            <View style={styles.courtsSection}>
              <Text style={styles.sectionHeaderTitle}>Sedes de Juego Simultáneas</Text>
              <View style={styles.courtsGrid}>
                <View style={styles.courtBox}>
                  <View style={styles.courtHeader}>
                    <Text style={styles.courtBadge}>CANCHA 1</Text>
                    <Text style={styles.courtPhase}>Fase de Grupos / SF1 / Final</Text>
                  </View>
                  <Text style={styles.courtTitle}>Grupo A</Text>
                  <Text style={styles.courtDesc}>Sábado 14 Nov & Domingo 15 Nov.</Text>
                </View>
                <View style={styles.courtBox}>
                  <View style={styles.courtHeader}>
                    <Text style={[styles.courtBadge, styles.courtBadgeB]}>CANCHA 2</Text>
                    <Text style={styles.courtPhase}>Fase de Grupos / SF2</Text>
                  </View>
                  <Text style={styles.courtTitle}>Grupo B</Text>
                  <Text style={styles.courtDesc}>Sábado 14 Nov & Domingo 15 Nov.</Text>
                </View>
              </View>
            </View>

            {/* Métricas Reales del Torneo */}
            <View style={styles.statsRow}>
              <View style={styles.statPill}>
                <Text style={styles.statNumber}>{data.teamsCount} / 8</Text>
                <Text style={styles.statTitle}>Equipos</Text>
              </View>
              <View style={styles.statPill}>
                <Text style={styles.statNumber}>{data.scheduledCount}</Text>
                <Text style={styles.statTitle}>Programados</Text>
              </View>
              <View style={[styles.statPill, data.inProgressCount > 0 && styles.statActivePill]}>
                <Text style={[styles.statNumber, data.inProgressCount > 0 && styles.statActiveNumber]}>
                  {data.inProgressCount}
                </Text>
                <Text style={styles.statTitle}>En juego</Text>
              </View>
              <View style={styles.statPill}>
                <Text style={styles.statNumber}>{data.completedCount}</Text>
                <Text style={styles.statTitle}>Finalizados</Text>
              </View>
            </View>

            {/* Módulos de Operación Deportiva */}
            <Text style={styles.sectionHeaderTitle}>Módulos Deportivos</Text>

            <View style={styles.menuGrid}>
              <Pressable
                onPress={() => router.push(data.hasMatches ? "./calendar" : "./groups")}
                style={({ pressed }) => [styles.menuCard, styles.menuCardPrimary, pressed && styles.pressed]}
              >
                <View style={styles.menuIconContainer}>
                  <Text style={styles.menuCardIcon}>⚡</Text>
                </View>
                <View style={styles.menuCardCopy}>
                  <Text style={styles.menuCardTitle}>Marcador Oficial en Vivo</Text>
                  <Text style={styles.menuCardSub}>
                    {data.hasMatches
                      ? "Control de puntos, sets, acumulado y tiempos muertos"
                      : "Genera el calendario de canchas para activar partidos"}
                  </Text>
                </View>
                <Text style={styles.menuArrow}>›</Text>
              </Pressable>

              <Pressable
                onPress={() => router.push("./teams")}
                style={({ pressed }) => [styles.menuCard, pressed && styles.pressed]}
              >
                <View style={[styles.menuIconContainer, styles.iconTeams]}>
                  <Text style={styles.menuCardIcon}>👥</Text>
                </View>
                <View style={styles.menuCardCopy}>
                  <Text style={styles.menuCardTitle}>Equipos y Nóminas</Text>
                  <Text style={styles.menuCardSub}>
                    {data.teamsCount} registrados · Validación de elegibilidad y cuota femenina
                  </Text>
                </View>
                <Text style={styles.menuArrow}>›</Text>
              </Pressable>

              <Pressable
                onPress={() => router.push("./groups")}
                style={({ pressed }) => [styles.menuCard, pressed && styles.pressed]}
