                </View>
              </View>
              <Text style={styles.didacticBody}>
                • Cada partido tiene <Text style={styles.highlight}>exactamente dos sets a 15 puntos base</Text>.{"\n"}
                • El ganador se define por la <Text style={styles.highlight}>suma acumulada global de puntos</Text> de ambos sets.{"\n"}
                • Si el acumulado queda empatado al cerrar el 2º set, <Text style={styles.highlight}>se prolonga el 2º set</Text> hasta lograr 2 puntos de ventaja o llegar a 21 máx (a 20-20 gana quien llegue a 21).
              </Text>
            </View>

            {/* Ficha 3: Criterios de Clasificación */}
            <View style={styles.didacticCard}>
              <View style={styles.didacticCardHeader}>
                <View style={[styles.didacticIconBox, styles.iconBoxGreen]}>
                  <Text style={styles.didacticIcon}>📊</Text>
                </View>
                <View style={styles.didacticHeaderCopy}>
                  <Text style={styles.didacticCardTitle}>Puntos de Tabla y Desempate</Text>
                  <Text style={styles.didacticCardTag}>TABLA GENERAL</Text>
                </View>
              </View>
              <Text style={styles.didacticBody}>
                • <Text style={styles.highlight}>Partido ganado:</Text> 2 puntos.{"\n"}
                • <Text style={styles.highlight}>Partido perdido disputado:</Text> 1 punto.{"\n"}
                • <Text style={styles.highlight}>Partido perdido por W.O.:</Text> 0 puntos (10 min tolerancia).{"\n"}
                • <Text style={styles.highlight}>Desempate oficial:</Text> Mayor diferencial de puntos a favor/en contra.
              </Text>
            </View>

            {/* Ficha 4: Fase Final Domingo 15 */}
            <View style={styles.didacticCard}>
              <View style={styles.didacticCardHeader}>
                <View style={[styles.didacticIconBox, styles.iconBoxBlue]}>
                  <Text style={styles.didacticIcon}>🏆</Text>
                </View>
                <View style={styles.didacticHeaderCopy}>
                  <Text style={styles.didacticCardTitle}>Fase Final (Domingo 15 Nov)</Text>
                  <Text style={styles.didacticCardTag}>ELIMINACIÓN DIRECTA A 21 PUNTOS</Text>
                </View>
              </View>
              <Text style={styles.didacticBody}>
                • Clasifican los 2 mejores de cada grupo:{"\n"}
                &nbsp;&nbsp;→ <Text style={styles.highlight}>Semifinal 1:</Text> 1º Grupo A vs 2º Grupo B{"\n"}
                &nbsp;&nbsp;→ <Text style={styles.highlight}>Semifinal 2:</Text> 1º Grupo B vs 2º Grupo A{"\n"}
                • Semifinales y Final <Text style={styles.highlight}>al mejor de 3 sets a 21 puntos</Text> con ventaja mínima de 2 puntos sin tope.
              </Text>
            </View>

            {/* Ficha 5: Datos del Torneo y Premio */}
            <View style={styles.prizeCard}>
              <Text style={styles.prizeEyebrow}>PREMIACIÓN OFICIAL</Text>
              <Text style={styles.prizeAmount}>$360.000 COP</Text>
              <Text style={styles.prizeTitle}>Premio único para el equipo campeón</Text>
              <Text style={styles.prizeSub}>Inscripción: $150.000 COP por equipo (pago previo al primer partido).</Text>
            </View>
          </View>
        )}

        {/* Footer de Modo Offline */}
        <Pressable onPress={() => router.push("./sync")} style={({ pressed }) => [styles.offlineFooter, pressed && styles.pressed]}>
          <View style={styles.offlineDot} />
          <Text style={styles.offlineText}>
            Persistencia offline en SQLite · {data.pendingSyncCount} pendientes ›
          </Text>
        </Pressable>
      </ScrollView>
    </SafeAreaView>
  );
}

