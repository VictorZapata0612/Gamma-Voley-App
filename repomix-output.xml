export async function createMatch(
  db: SQLiteDatabase,
  match: Match & {
    tournamentId: string;
    scheduledAt?: string;
    courtNumber?: 1 | 2;
  }
): Promise<void> {
  const now = new Date().toISOString();

  await db.execAsync("BEGIN TRANSACTION;");
  try {
    await db.runAsync(
      `INSERT INTO matches (
        id, tournament_id, phase, home_team_id, away_team_id,
        court_number, scheduled_at, status, winner, current_set,
        created_at, updated_at
      )
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      match.id,
      match.tournamentId,
      match.phase,
      match.homeTeamId,
      match.awayTeamId,
      match.courtNumber ?? null,
      match.scheduledAt ?? null,
      match.status,
      match.winner,
      match.currentSet,
      now,
      now
    );

    await enqueueSyncOperation(
      db,
      `sync-match-${match.id}`,
      "match",
      match.id,
      "save_match",
      {
        tournamentId: match.tournamentId,
        phase: match.phase,
        homeTeamId: match.homeTeamId,
        awayTeamId: match.awayTeamId,
        courtNumber: match.courtNumber ?? null,
        scheduledAt: match.scheduledAt ?? null,
        status: match.status,
        winner: match.winner,
        currentSet: match.currentSet,
      }
    );

    for (const [index, set] of match.sets.entries()) {
      const setNumber = index + 1;

      await db.runAsync(
        `INSERT INTO match_sets (
          match_id, set_number, home_points, away_points
        ) VALUES (?, ?, ?, ?)`,
        match.id,
        setNumber,
        set.home,
        set.away
      );

      await enqueueSyncOperation(
        db,
        `sync-set-${match.id}-${setNumber}`,
        "match_set",
        match.id,
        "save_set",
        {
          matchId: match.id,
          setNumber,
          homePoints: set.home,
          awayPoints: set.away,
        }
      );
    }

    await db.execAsync("COMMIT;");
  } catch (error) {
    await db.execAsync("ROLLBACK;");
    throw error;
  }
}



export async function appendScoreAction(
  db: SQLiteDatabase,
  matchId: string,
  setNumber: number,
  action: ScoreAction
): Promise<void> {
  if (!Number.isInteger(setNumber) || setNumber < 1) {
    throw new Error("El número de set no es válido.");
  }

  const now = new Date().toISOString();

  await db.execAsync("BEGIN TRANSACTION;");
  try {
    const existingEvent = await db.getFirstAsync<{ id: string }>(
      "SELECT id FROM score_events WHERE id = ?",
      action.id
    );

    if (existingEvent) {
      await db.execAsync("COMMIT;");
      return;
    }

    const column =
      action.team === "home" ? "home_points" : "away_points";

    const updateResult = await db.runAsync(
      `UPDATE match_sets
       SET ${column} = ${column} + ?
       WHERE match_id = ?
         AND set_number = ?
         AND ${column} + ? >= 0`,
      action.delta,
      matchId,
      setNumber,
      action.delta
    );

    if (updateResult.changes !== 1) {
      throw new Error(
        "No se pudo actualizar el set: puede no existir o el marcador sería negativo."
      );
    }

    await db.runAsync(
      `INSERT INTO score_events (
        id, match_id, set_number, team, delta, reason, created_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?)`,
      action.id,
      matchId,
      setNumber,
      action.team,
      action.delta,
      action.reason ?? null,
      now
    );

    await enqueueSyncOperation(
      db,
      `sync-${action.id}`,
      "match",
      matchId,
      "record_score_action",
      {
        actionId: action.id,
        setNumber,
        team: action.team,
        delta: action.delta,
        timestamp: now,
      }
    );

    await db.execAsync("COMMIT;");
  } catch (error) {
    await db.execAsync("ROLLBACK;");
    throw error;
  }
}


export async function saveTimeout(
  db: SQLiteDatabase,
  matchId: string,
  setNumber: number,
  team: "home" | "away"
): Promise<void> {
  const now = new Date().toISOString();
  try {
